<div class="pq-announce" style="--c: {{color}};">
    <img class="pq-announce-avatar" src="{{avatar}}" alt="" draggable="false"
         onerror="this.onerror=null;this.src='{{fallbackAvatar}}'">
    <div class="pq-announce-body">
        <strong class="pq-announce-name">{{name}}</strong>
        <span class="pq-announce-text">{{text}}</span>
        <span class="pq-announce-priority">{{priorityName}}</span>
    </div>
    <img class="pq-announce-flag" src="{{icon}}" alt="" draggable="false">
</div>
